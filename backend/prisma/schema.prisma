generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  senior
  superadmin
}

model Company {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  incidents       Incident[]
  subscription    CompanySubscription?
  payments        PaymentHistory[]
  invoices        Invoice[]
  ledgerEntries   Ledger[]
  permissions     CompanyPermission[]

  @@map("companies")
}

model CompanyPermission {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String   @map("company_id") @db.ObjectId
  permission String
  roles      String[] @default([])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, permission])
  @@index([companyId])
  @@map("company_permissions")
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String?   @map("company_id") @db.ObjectId
  name           String
  surname        String?
  email          String    @unique
  passwordHash   String    @map("password_hash")
  role           UserRole  @default(senior)
  status         String    @default("active")
  loginAttempts  Int       @default(0) @map("login_attempts")
  lockoutCount   Int       @default(0) @map("lockout_count")
  lockedUntil    DateTime? @map("locked_until")
  emailVerified Boolean   @default(false) @map("email_verified")
  // Stamped on logout. A refresh that started before this moment must not
  // leave a replacement token behind (see AuthService.refresh).
  sessionsRevokedAt DateTime? @map("sessions_revoked_at")
  createdBy      String?   @map("created_by") @db.ObjectId
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company           Company?        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator           User?           @relation("created_users", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUsers      User[]          @relation("created_users")
  reportedIncidents Incident[]      @relation("reporter")
  assignedIncidents Incident[]      @relation("assigned_investigator")
  auditLogs         AuditLog[]

  refreshTokens     RefreshToken[]

  @@index([companyId])
  @@index([createdBy])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @map("user_id") @db.ObjectId
  tokenHash  String   @unique @map("token_hash")
  deviceInfo String?  @map("device_info")
  familyId   String   @map("family_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Incident {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String   @map("company_id") @db.ObjectId
  referenceNumber   String   @unique @map("reference_number")
  title             String
  description       String
  type              String
  status            String   @default("draft")
  incidentDate      DateTime @map("incident_date")
  location          String?
  operatorName      String   @map("operator_name")
  dispatcher        String   @map("dispatcher")
  dispatchTime      DateTime? @map("dispatch_time")
  arrivalTime       DateTime? @map("arrival_time")
  callSign          String?  @map("call_sign")
  suburb            String?
  city              String?
  propertyAddress   String?  @map("property_address")
  clientName        String?  @map("client_name")
  clientCode        String?  @map("client_code")
  businessOrComplex String?  @map("business_or_complex")
  sapsReference     String?  @map("saps_reference")
  reporterId        String   @map("reporter_id") @db.ObjectId
  assignedTo        String?  @map("assigned_to") @db.ObjectId
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reporter          User               @relation("reporter", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedInvestigator User?           @relation("assigned_investigator", fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)


  @@index([companyId])
  @@index([status])
  @@index([reporterId])
  @@index([assignedTo])
  @@index([incidentDate])
  @@map("incidents")
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @map("user_id") @db.ObjectId
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model SubscriptionPlan {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  price        Int      @map("price")
  userLimit      Int      @map("user_limit")
  reportLimit    Int      @default(0) @map("report_limit")
  trialPeriodDays Int?    @map("trial_period_days")
  features       String
  highlighted    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions CompanySubscription[]

  @@map("subscription_plans")
}

model CompanySubscription {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId                String    @unique @map("company_id") @db.ObjectId
  planId                   String    @map("plan_id") @db.ObjectId
  status                   String    @default("active")
  currentPeriodStart       DateTime? @map("current_period_start")
  trialEndsAt              DateTime? @map("trial_ends_at")
  trialStartedAt           DateTime? @map("trial_started_at")
  trialWarningSent         Boolean   @default(false) @map("trial_warning_sent")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("company_subscriptions")
}

model PaymentHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String   @map("company_id") @db.ObjectId
  amount       Int      @map("amount")
  currency     String   @default("ZAR")
  reference    String   @unique
  status       String   @default("pending")
  invoiceId    String?  @map("invoice_id") @db.ObjectId

  createdAt    DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@index([invoiceId])
  @@map("payment_history")
}

model Invoice {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String    @map("company_id") @db.ObjectId
  invoiceNumber String   @unique @map("invoice_number")
  amount       Int       @map("amount")
  currency     String    @default("ZAR")
  status       String    @default("draft")
  dueDate      DateTime  @map("due_date")
  paidAt       DateTime? @map("paid_at")
  periodStart  DateTime? @map("period_start")
  periodEnd    DateTime? @map("period_end")
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company  Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments PaymentHistory[]

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Ledger {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String   @map("company_id") @db.ObjectId
  entryType   String   @map("entry_type")
  amount      Int      @map("amount")
  currency    String   @default("ZAR")
  description String?
  reference   String?
  status      String   @default("posted")
  postedAt    DateTime @map("posted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@index([entryType])
  @@index([status])
  @@index([postedAt])
  @@map("ledger_entries")
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  action       String
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  oldValues    String?  @map("old_values")
  newValues    String?  @map("new_values")
  performedBy  String   @map("performed_by") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")

  performedByUser User @relation(fields: [performedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([createdAt])
  @@map("audit_logs")
}
