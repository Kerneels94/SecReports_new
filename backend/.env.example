# --- Server ---
PORT=4000
NODE_ENV=development
ENVIRONMENT=development
DATABASE_URL=mongodb://localhost:27017/secreports
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Auth secrets (min 32 chars each) ---
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-chars

# --- Passwords ---
BCRYPT_SALT_ROUNDS=12

# --- Email (Resend preferred; SMTP used as fallback) ---
RESEND_API_KEY=re_XXXXXXXX
FROM_EMAIL=onboarding@resend.dev
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass

# --- PostHog (optional) ---
# POSTHOG_API_KEY=phc_XXXXXXXX
# POSTHOG_HOST=https://us.i.posthog.com

# --- Seed script (backend) ---
# SUPER_ADMIN_EMAIL=superadmin@example.com
# SUPER_ADMIN_PASSWORD=change-me-to-a-strong-value
# DEMO_PASSWORD=demo-passwords-print-once-if-unset