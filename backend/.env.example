# --- Server ---
PORT=4000
NODE_ENV=development
ENVIRONMENT=development
DATABASE_URL=mongodb://localhost:27017/secreports
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Auth secrets (min 32 chars each) ---
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-chars

# --- Passwords ---
BCRYPT_SALT_ROUNDS=12

# --- Email (Resend HTTP API, no SMTP / no outbound port 25) ---
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=support@secreports.co.za
ADMIN_FROM_EMAIL=accounts@secreports.co.za
OWNER_NOTIFY_EMAIL=accounts@secreports.co.za

# --- Local email testing (dev only) ---
# Set these to route mail to an Ethereal inbox instead of Resend in dev.
# Preview URLs print to the console; nothing is delivered. Ignored in prod/test.
# Get a throwaway inbox at https://ethereal.email/create
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-ethereal-user
# SMTP_PASS=your-ethereal-pass

# --- PostHog (optional) ---
# POSTHOG_API_KEY=phc_XXXXXXXX
# POSTHOG_HOST=https://us.i.posthog.com

# --- Seed script (backend) ---
# SUPER_ADMIN_EMAIL=superadmin@example.com
# SUPER_ADMIN_PASSWORD=change-me-to-a-strong-value
# DEMO_PASSWORD=demo-passwords-print-once-if-unset