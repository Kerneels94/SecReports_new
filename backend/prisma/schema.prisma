generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  incidents    Incident[]
  subscription CompanySubscription?
  payments     PaymentHistory[]
  apiKeys      ApiKey[]

  @@map("companies")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String   @map("company_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("senior")
  status       String   @default("active")
  createdBy    String?  @map("created_by") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator           User?              @relation("created_users", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUsers      User[]             @relation("created_users")
  reportedIncidents Incident[]         @relation("reporter")
  assignedIncidents Incident[]         @relation("assigned_investigator")
  comments          Comment[]
  uploadedEvidence  Evidence[]
  actionOwner       CorrectiveAction[]
  auditLogs         AuditLog[]

  @@index([companyId])
  @@index([createdBy])
  @@map("users")
}

model Incident {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String   @map("company_id") @db.ObjectId
  referenceNumber   String   @unique @map("reference_number")
  title             String
  description       String
  type              String
  severity          String   @default("medium")
  status            String   @default("draft")
  incidentDate      DateTime @map("incident_date")
  location          String?
  operatorName      String   @map("operator_name")
  dispatcher        String   @map("dispatcher")
  dispatchTime      DateTime? @map("dispatch_time")
  arrivalTime       DateTime? @map("arrival_time")
  callSign          String?  @map("call_sign")
  propertyAddress   String?  @map("property_address")
  clientName        String?  @map("client_name")
  clientCode        String?  @map("client_code")
  businessOrComplex String?  @map("business_or_complex")
  sapsReference     String?  @map("saps_reference")
  reporterId        String   @map("reporter_id") @db.ObjectId
  assignedTo        String?  @map("assigned_to") @db.ObjectId
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reporter          User               @relation("reporter", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedInvestigator User?           @relation("assigned_investigator", fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  people            IncidentPerson[]
  evidence          Evidence[]
  comments          Comment[]
  investigation     Investigation?
  correctiveActions CorrectiveAction[]

  @@index([companyId])
  @@index([status])
  @@index([severity])
  @@index([reporterId])
  @@index([assignedTo])
  @@index([incidentDate])
  @@map("incidents")
}

model IncidentPerson {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  incidentId String @map("incident_id") @db.ObjectId
  name       String
  role       String
  contact    String?
  notes      String?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([incidentId])
  @@map("incident_people")
}

model Evidence {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId   String   @map("incident_id") @db.ObjectId
  fileName     String   @map("file_name")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  fileSize     Int      @map("file_size")
  checksum     String
  uploadedBy   String   @map("uploaded_by") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploader User     @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([incidentId])
  @@index([uploadedBy])
  @@map("evidence")
}

model Comment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId String   @map("incident_id") @db.ObjectId
  userId     String   @map("user_id") @db.ObjectId
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([incidentId])
  @@map("comments")
}

model Investigation {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  incidentId      String    @unique @map("incident_id") @db.ObjectId
  findings        String?
  rootCause       String?   @map("root_cause")
  recommendations String?
  closureNotes    String?   @map("closure_notes")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("investigations")
}

model CorrectiveAction {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  incidentId   String    @map("incident_id") @db.ObjectId
  description  String
  ownerId      String    @map("owner_id") @db.ObjectId
  dueDate      DateTime  @map("due_date")
  status       String    @default("open")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([incidentId])
  @@index([ownerId])
  @@index([status])
  @@map("corrective_actions")
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

model SubscriptionPlan {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  price        Int      @map("price")
  reportLimit  Int      @map("report_limit")
  userLimit    Int      @map("user_limit")
  features     String
  highlighted  Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions CompanySubscription[]

  @@map("subscription_plans")
}

model CompanySubscription {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId                String   @unique @map("company_id") @db.ObjectId
  planId                   String   @map("plan_id") @db.ObjectId
  status                   String   @default("active")
  paystackSubscriptionCode String?  @map("paystack_subscription_code")
  paystackCustomerCode     String?  @map("paystack_customer_code")
  authorizationCode        String?  @map("authorization_code")
  currentPeriodStart       DateTime? @map("current_period_start")
  currentPeriodEnd         DateTime? @map("current_period_end")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("company_subscriptions")
}

model PaymentHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String   @map("company_id") @db.ObjectId
  amount       Int      @map("amount")
  currency     String   @default("ZAR")
  reference    String   @unique
  status       String   @default("pending")
  paystackData String?  @map("paystack_data")
  createdAt    DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@map("payment_history")
}

model ApiKey {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String    @map("company_id") @db.ObjectId
  name       String
  key        String    @unique
  lastUsedAt DateTime? @map("last_used_at")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@map("api_keys")
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  action       String
  oldValues    String?  @map("old_values")
  newValues    String?  @map("new_values")
  performedBy  String   @map("performed_by") @db.ObjectId
  createdAt    DateTime @default(now()) @map("created_at")

  performedByUser User @relation(fields: [performedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([createdAt])
  @@map("audit_logs")
}
